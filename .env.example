# Copy to .env and enter your own existing database connection.
PORT=3000
DBHOST=127.0.0.1
DBPORT=3306
DBUSER=your_database_user
DBPASSWORD=your_database_password
DBDATABASE=midvejsprojekt_pokemon
# Captures persist in the existing trainer_pokemon table. Set false for read-only use.
ENABLE_CATCHES=true
